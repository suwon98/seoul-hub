# Shell/provider environment variables; Spring does not load this file automatically.
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mariadb://YOUR_DB_HOST:YOUR_DB_PORT/defaultdb?sslMode=verify-full&serverSslCert=/etc/secrets/aiven-ca.pem
SPRING_DATASOURCE_USERNAME=YOUR_DB_USER
SPRING_DATASOURCE_PASSWORD=
HIBERNATE_DIALECT=org.seoulhub.backend.global.config.MySqlMariaDbDriverDialect
JWT_SECRET=
API_PROXY_SECRET=
SEOUL_API_KEY=
SEOUL_COLLECTION_REQUEST_DELAY_MS=1000
SEOUL_COLLECTION_DAILY_BUDGET=900

# Account verification/recovery mail: HTTPS API (Render Free blocks SMTP).
APP_PUBLIC_ORIGIN=https://YOUR_APP.vercel.app
MAIL_MODE=brevo
BREVO_API_KEY=
MAIL_SENDER_EMAIL=
MAIL_SENDER_NAME=Seoul Hub
